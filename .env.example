# Application runtime
APP_ENV=development
LOG_LEVEL=INFO
OBSERVABILITY_ENABLED=false
DEV_AUTH_ENABLED=true
REGISTRATION_ENABLED=true
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
CADDY_TURNSTILE_CSP_ORIGIN=

# Email Verification & SMTP (when SMTP_HOST is empty, verification links are logged at INFO level)
PUBLIC_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@trip-animator.local
SMTP_USE_TLS=true
EMAIL_VERIFICATION_TTL_HOURS=24

# Database (PostgreSQL 17)
POSTGRES_DB=trip_animator
POSTGRES_USER=trip_app
POSTGRES_PASSWORD=dev-postgres-password-change-me
DATABASE_URL=postgresql+psycopg://trip_app:dev-postgres-password-change-me@localhost:5432/trip_animator

# Security & encryption (generate >= 32 random bytes in production)
SESSION_SECRET=dev-only-session-secret-minimum-32-characters-long
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Object Storage ("local" or "s3")
OBJECT_STORE_BACKEND=local
LOCAL_OBJECT_STORE_DIR=./data/objects
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin-change-me
S3_BUCKET=trip-animator
S3_REGION=us-east-1

# Marked Trails store (current.json lives here): a root-relative path or an https URL; empty turns
# the overlay off. `make dev-api` sets the local path that Vite serves from .tmp/marked-trails/store.
MARKED_TRAILS_BASE_URL=

# Marked Trails publisher (trip-marked-trails build-publish): local (default when empty) or s3.
# The s3 publisher uses AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in the Remote Render section, so that IAM user
# needs the publisher policy too; with both empty the default AWS chain applies.
MARKED_TRAILS_STORE=
MARKED_TRAILS_S3_BUCKET=
MARKED_TRAILS_S3_PREFIX=
# Local store root of the build-publish CLI when MARKED_TRAILS_STORE is local (not mounted in Airflow).
MARKED_TRAILS_STORE_DIR=
# Where the Marked Trails DAG runs the build: local (default when empty) or fargate. fargate starts the
# builder task of infra/terraform/standalone-remote-render with boto3 and needs the Terraform outputs below;
# marked_trails_builder_enabled must be true in Terraform and the IAM user of AWS_ACCESS_KEY_ID also needs
# marked_trails_fargate_launcher_policy_arn. MARKED_TRAILS_FARGATE_SUBNETS is the comma-separated subnet ids output.
MARKED_TRAILS_BUILD_BACKEND=
MARKED_TRAILS_FARGATE_CLUSTER=
MARKED_TRAILS_FARGATE_TASK_DEFINITION=
MARKED_TRAILS_FARGATE_SUBNETS=
MARKED_TRAILS_FARGATE_SECURITY_GROUPS=
MARKED_TRAILS_FARGATE_TIMEOUT_SECONDS=

# Strava OAuth2 (Import-only PKCE + state)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback

# Google OIDC Sign-In (optional; separate from legacy Google Photos placeholders)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Map Tiles & Worker Rendering
MAP_TILE_ALLOWLIST=https://tiles.openfreemap.org
# The API reads RENDER_BASE_URL only to reach a root-relative MARKED_TRAILS_BASE_URL for its own
# current.json read; production uses an https MARKED_TRAILS_BASE_URL and needs no resolution.
RENDER_BASE_URL=http://localhost:5173
WORKER_CONCURRENCY=1
WORKER_GPU_ENABLED=false
WORKER_CPU_RENDERER=lavapipe
# Set both when using infra/compose.worker-gpu.yaml; the GID is that of the host render node.
# WORKER_GPU_DEVICE=/dev/dri/renderD128
# WORKER_GPU_RENDER_GID=

# Remote Render Backend ("local" or "aws_sfn_lambda")
# One IAM user and one region for the render backend and the Marked Trails publisher; set both
# keys or neither (neither means the default AWS chain, for example an instance role). The old
# names RENDER_AWS_REGION, RENDER_AWS_ACCESS_KEY_ID, RENDER_AWS_SECRET_ACCESS_KEY and
# MARKED_TRAILS_S3_REGION stop the API and the publisher at startup.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RENDER_BACKEND=local
RENDER_AWS_STATE_MACHINE_ARN=
RENDER_AWS_STAGING_BUCKET=
RENDER_AWS_ENDPOINT_URL=
RENDER_CALLBACK_BASE_URL=
RENDER_CALLBACK_SECRET=
RENDER_REMOTE_CHUNK_THRESHOLD_FRAMES=300
RENDER_REMOTE_CHUNK_SIZE_FRAMES=200
RENDER_REMOTE_PREROLL_FRAMES=15
RENDER_REMOTE_DISPATCH_INTERVAL_S=2.0
RENDER_REMOTE_MAX_ATTEMPTS=3
RENDER_REMOTE_MAX_INFLIGHT=3

# Per-User Quotas, Server Render Caps & Runtime Scaling
UVICORN_WORKERS=2
MAX_PROJECTS_PER_USER=25
MAX_STAGES_PER_PROJECT=30
MAX_ACTIVE_RENDERS_PER_USER=1
SERVER_RENDER_MAX_DURATION_S=120.0
SERVER_RENDER_MAX_FPS_LOCAL=30
SERVER_RENDER_MAX_FPS_REMOTE=60

# Optional Apache Airflow 3 Orchestration (--profile airflow)
AIRFLOW_PORT=8081
AIRFLOW_DB=airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_SIMPLE_AUTH_USERS=
GOLD_OUTPUT_DIR=./data/gold

# Docker Compose & Reverse Proxy (infra/compose.yaml)
# Set DOMAIN=http://your-subdomain.example.com when running behind an external reverse proxy/Cloudflare.
DOMAIN=localhost
COMPOSE_ALLOWED_ORIGINS=http://localhost,https://localhost,http://localhost:5173,http://localhost:8080
# Use e.g. 127.0.0.1:8080:80 and 127.0.0.1:8443:443 when running behind host Nginx.
CADDY_HTTP_PUBLISH=80:80
CADDY_HTTPS_PUBLISH=443:443
