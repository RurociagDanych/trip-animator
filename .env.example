# Application runtime
APP_ENV=development
LOG_LEVEL=INFO
DEV_AUTH_ENABLED=true

# Database (PostgreSQL 17)
POSTGRES_DB=trip_animator
POSTGRES_USER=trip_app
POSTGRES_PASSWORD=dev-postgres-password-change-me
DATABASE_URL=postgresql+psycopg://trip_app:dev-postgres-password-change-me@localhost:5432/trip_animator

# Security & encryption (generate >= 32 random bytes in production)
SESSION_SECRET=dev-only-session-secret-minimum-32-characters-long
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Object Storage ("local" or "s3")
OBJECT_STORE_BACKEND=local
LOCAL_OBJECT_STORE_DIR=./data/objects
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin-change-me
S3_BUCKET=trip-animator
S3_REGION=us-east-1

# Strava OAuth2 (Import-only PKCE + state)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:5173/strava/callback

# Map Tiles & Worker Rendering
MAP_TILE_ALLOWLIST=https://tiles.openfreemap.org
RENDER_BASE_URL=http://localhost:5173
WORKER_CONCURRENCY=1

# Optional Apache Airflow 3 Orchestration (--profile airflow)
AIRFLOW_PORT=8081
AIRFLOW_DB=airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_API_SECRET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_SIMPLE_AUTH_USERS=
GOLD_OUTPUT_DIR=./data/gold
