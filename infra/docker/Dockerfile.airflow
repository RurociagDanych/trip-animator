FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /uvx /bin/

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    AIRFLOW_HOME=/opt/airflow \
    TRIP_DBT_PROJECT_DIR=/app/dbt

WORKDIR /app

COPY pyproject.toml uv.lock* ./
COPY packages/telemetry/pyproject.toml ./packages/telemetry/pyproject.toml
COPY apps/api/pyproject.toml ./apps/api/pyproject.toml
COPY apps/worker/pyproject.toml ./apps/worker/pyproject.toml
COPY airflow/pyproject.toml airflow/uv.lock* ./airflow/

RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -f airflow/uv.lock ]; then \
        uv sync --project /app/airflow --frozen --no-dev --no-install-workspace --no-install-package trip-api --no-install-package trip-telemetry; \
    else \
        uv sync --project /app/airflow --no-dev --no-install-workspace --no-install-package trip-api --no-install-package trip-telemetry; \
    fi

COPY packages/telemetry ./packages/telemetry
COPY apps/api ./apps/api
COPY dbt ./dbt
COPY airflow/src ./airflow/src
COPY airflow/dags ./airflow/dags

RUN --mount=type=cache,target=/root/.cache/uv \
    if [ -f airflow/uv.lock ]; then \
        uv sync --project /app/airflow --frozen --no-dev --no-editable; \
    else \
        uv sync --project /app/airflow --no-dev --no-editable; \
    fi

RUN groupadd --system --gid 10001 appgroup \
    && useradd --system --uid 10001 --gid appgroup --create-home --home-dir /home/appuser --shell /usr/sbin/nologin appuser \
    && mkdir -p /home/appuser/.duckdb /opt/airflow/logs /data/objects /data/gold /app/data/ref \
    && /app/.venv/bin/python -c "from pathlib import Path; from trip_telemetry.ref_data import resolve_ref_data_dir; resolve_ref_data_dir(Path('/app/data/ref'), ensure_exists=True)" \
    && HOME=/home/appuser /app/.venv/bin/python -c "import duckdb; con = duckdb.connect(); con.execute('INSTALL spatial'); con.execute('INSTALL parquet')" || true \
    && chmod -R a+rX /app/data/ref \
    && chown -R 10001:10001 /home/appuser /opt/airflow /data/objects /data/gold

ENV HOME=/home/appuser

USER 10001:10001

EXPOSE 8080

CMD ["airflow", "standalone"]
