aws_region             = "eu-central-1"
name_prefix            = "trip-animator-remote-render"
image_tag              = "latest"
lambda_memory_mb       = 10240
lambda_timeout_seconds         = 900
reserved_concurrent_executions = 24
sfn_max_concurrency            = 8
staging_retention_days = 3
map_tile_allowlist     = "https://tiles.openfreemap.org"
render_callback_secret = ""
marked_trails_app_origins = ["https://trips.example.com"]
marked_trails_prefix      = "marked-trails"
