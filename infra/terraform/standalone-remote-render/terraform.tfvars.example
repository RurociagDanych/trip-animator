aws_region             = "us-east-1"
name_prefix            = "trip-animator-remote-render"
image_tag              = "latest"
lambda_memory_mb       = 10240
lambda_timeout_seconds         = 900
reserved_concurrent_executions = 24
sfn_max_concurrency            = 8
staging_retention_days = 3
# Add the Marked Trails CloudFront origin (output marked_trails_cloudfront_origin), for example
# "https://tiles.openfreemap.org,https://<id>.cloudfront.net"; Lambda renders reach only these hosts.
map_tile_allowlist     = "https://tiles.openfreemap.org"
render_callback_secret = ""
marked_trails_app_origins = ["https://trips.example.com"]
marked_trails_prefix      = "marked-trails"
# The Fargate builder for the Marked Trails build is off by default. To enable it, set the toggle
# and the tag that make marked-trails-ecr-push pushed (the tag has no default).
marked_trails_builder_enabled   = false
marked_trails_builder_image_tag = ""

# IAM user whose keys the VPS uses; Terraform attaches the dispatcher, publisher and launcher
# policies to it. Empty attaches nothing.
vps_iam_user_name = ""
